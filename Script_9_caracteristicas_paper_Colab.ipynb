
# ============================================================
# PREDICCIÓN DE LAS 9 CARACTERÍSTICAS NUCLEARES DEL PAPER
# Google Colab - núcleos/células individuales con fondo blanco
# ============================================================

import sys, subprocess
subprocess.check_call([
    sys.executable, "-m", "pip", "install", "-q",
    "huggingface_hub", "openpyxl", "scikit-learn",
    "torchvision", "pandas", "matplotlib", "pillow"
])

import io
import zipfile
import shutil
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from PIL import Image

import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
from torchvision.models import convnext_base

from huggingface_hub import hf_hub_download
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from google.colab import files

LABELS = [
    "Nuclear elongation",
    "Nuclear grooves",
    "Intranuclear inclusion",
    "Glassy / ground glass nuclei",
    "Nuclear crowding",
    "Wrinkled nuclear membrane",
    "Nuclear enlargement",
    "Irregular nuclear contour",
    "Nuclear overlapping",
]

SAFE = [
    "elongation",
    "grooves",
    "intranuclear_inclusion",
    "ground_glass",
    "crowding",
    "wrinkled_membrane",
    "enlargement",
    "irregular_contour",
    "overlapping",
]

IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp"}
EXCLUDE_WORDS = ["mask","mascara","máscara","montage","montaje","preview","combined"]

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
BATCH_SIZE = 32

print("Dispositivo:", DEVICE)
print("\nSube tu ZIP con los núcleos/células con fondo blanco.")
uploaded = files.upload()

zip_candidates = [k for k in uploaded if k.lower().endswith(".zip")]
if not zip_candidates:
    raise ValueError("Debes subir un archivo ZIP.")

ZIP_NAME = zip_candidates[0]

EXTRACT_DIR = Path("/content/mis_nucleos")
if EXTRACT_DIR.exists():
    shutil.rmtree(EXTRACT_DIR)
EXTRACT_DIR.mkdir(parents=True)

with zipfile.ZipFile(ZIP_NAME, "r") as z:
    z.extractall(EXTRACT_DIR)

all_images = [
    p for p in EXTRACT_DIR.rglob("*")
    if p.is_file() and p.suffix.lower() in IMAGE_EXTS
]

def valid_image(p):
    name = p.stem.lower()
    return not any(w in name for w in EXCLUDE_WORDS)

image_paths = [p for p in all_images if valid_image(p)]

# Si tus imágenes se llaman nucleo_1, nucleo_2, etc., usa solo esas.
nucleo_named = [p for p in image_paths if p.stem.lower().startswith("nucleo_")]
if nucleo_named:
    image_paths = nucleo_named

print("Imágenes seleccionadas:", len(image_paths))
if not image_paths:
    raise ValueError("No se encontraron imágenes válidas.")

# Modelo ConvNeXt-Base con 9 salidas
model = convnext_base(weights=None)
num_ftrs = model.classifier[2].in_features
model.classifier[2] = nn.Sequential(
    nn.LayerNorm((num_ftrs,), eps=1e-6),
    nn.Linear(num_ftrs, 9)
)

print("\nDescargando modelo preentrenado...")
model_path = hf_hub_download(
    repo_id="SoftmaxSamurai/ConvNext_SCTC",
    filename="best_model.pth"
)

checkpoint = torch.load(model_path, map_location="cpu", weights_only=False)

model.load_state_dict(checkpoint["model"], strict=True)
model = model.to(DEVICE)
model.eval()

thresholds = checkpoint["thresholds"]
if torch.is_tensor(thresholds):
    thresholds = thresholds.detach().cpu().numpy()
thresholds = np.asarray(thresholds, dtype=float).reshape(-1)

print("\nThresholds del modelo:")
for lab, t in zip(LABELS, thresholds):
    print(f"{lab}: {t:.4f}")

transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])

class NucleiDataset(Dataset):
    def __init__(self, paths, root):
        self.paths = paths
        self.root = root

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        p = self.paths[idx]
        img = Image.open(p).convert("RGB")
        x = transform(img)

        rel = p.relative_to(self.root)
        paciente = rel.parts[-2] if len(rel.parts) >= 2 else "sin_carpeta"

        return x, p.stem, p.name, paciente, str(p)

dataset = NucleiDataset(image_paths, EXTRACT_DIR)
loader = DataLoader(
    dataset,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=2,
    pin_memory=(DEVICE.type == "cuda")
)

rows = []

print("\nAnalizando imágenes...")

with torch.no_grad():
    for batch_idx, (x, ids, filenames, pacientes, paths) in enumerate(loader):
        x = x.to(DEVICE)
        logits = model(x)
        probs = torch.sigmoid(logits).cpu().numpy()
        preds = (probs >= thresholds[None, :]).astype(int)

        for i in range(len(ids)):
            row = {
                "id": ids[i],
                "archivo": filenames[i],
                "paciente": pacientes[i],
                "ruta": paths[i],
            }

            for k, safe in enumerate(SAFE):
                row[f"P_{safe}"] = float(probs[i, k])
                row[f"Pred_{safe}"] = int(preds[i, k])

            row["n_rasgos_positivos"] = int(preds[i].sum())
            rows.append(row)

        done = min((batch_idx + 1) * BATCH_SIZE, len(dataset))
        print(f"Procesados: {done}/{len(dataset)}")

pred_df = pd.DataFrame(rows)

OUT = Path("/content/resultados_caracteristicas_paper")
if OUT.exists():
    shutil.rmtree(OUT)
OUT.mkdir(parents=True)

pred_df.to_csv(OUT / "Caracteristicas_paper_por_nucleo.csv", index=False)
pred_df.to_excel(OUT / "Caracteristicas_paper_por_nucleo.xlsx", index=False)

threshold_df = pd.DataFrame({
    "Caracteristica": LABELS,
    "Threshold_modelo": thresholds
})
threshold_df.to_csv(OUT / "Thresholds_modelo.csv", index=False)

# Resumen por paciente/carpeta
agg = {}
for safe in SAFE:
    agg[f"P_{safe}"] = "mean"
    agg[f"Pred_{safe}"] = "mean"

patient_df = pred_df.groupby("paciente", as_index=False).agg(agg)
counts = pred_df.groupby("paciente").size().rename("N_nucleos").reset_index()
patient_df = counts.merge(patient_df, on="paciente", how="left")

rename = {}
for safe in SAFE:
    rename[f"P_{safe}"] = f"Media_P_{safe}"
    rename[f"Pred_{safe}"] = f"Porcentaje_positivo_{safe}"

patient_df = patient_df.rename(columns=rename)

for safe in SAFE:
    patient_df[f"Porcentaje_positivo_{safe}"] *= 100

patient_df.to_csv(OUT / "Resumen_por_paciente.csv", index=False)
patient_df.to_excel(OUT / "Resumen_por_paciente.xlsx", index=False)

with pd.ExcelWriter(OUT / "Resultados_9_caracteristicas_paper.xlsx", engine="openpyxl") as writer:
    pred_df.to_excel(writer, sheet_name="Por_nucleo", index=False)
    patient_df.to_excel(writer, sheet_name="Por_paciente", index=False)
    threshold_df.to_excel(writer, sheet_name="Thresholds", index=False)

# Figura 1: prevalencia global
prev = pd.Series({
    lab: pred_df[f"Pred_{safe}"].mean() * 100
    for lab, safe in zip(LABELS, SAFE)
}).sort_values()

fig, ax = plt.subplots(figsize=(9, 6))
ax.barh(prev.index, prev.values)
ax.set_xlabel("Núcleos positivos (%)")
ax.set_title("Características nucleares predichas por el modelo")
fig.tight_layout()
fig.savefig(OUT / "Figura_1_prevalencia_9_rasgos.png", dpi=300, bbox_inches="tight")
plt.show()

# Figura 2: heatmap paciente x rasgo
heat_cols = [f"Porcentaje_positivo_{s}" for s in SAFE]
mat = patient_df.set_index("paciente")[heat_cols]

fig, ax = plt.subplots(figsize=(12, max(7, len(mat) * 0.28)))
im = ax.imshow(mat.values, aspect="auto", vmin=0, vmax=100)

ax.set_xticks(range(len(LABELS)))
ax.set_xticklabels(LABELS, rotation=90)
ax.set_yticks(range(len(mat)))
ax.set_yticklabels(mat.index)
ax.set_title("Porcentaje de núcleos positivos por paciente")
cb = fig.colorbar(im, ax=ax)
cb.set_label("% de núcleos positivos")

fig.tight_layout()
fig.savefig(OUT / "Figura_2_heatmap_pacientes_9_rasgos.png", dpi=300, bbox_inches="tight")
plt.show()

# Figura 3: PCA por paciente
prob_cols = [f"Media_P_{s}" for s in SAFE]

if len(patient_df) >= 3:
    X = patient_df[prob_cols].replace([np.inf, -np.inf], np.nan)
    X = X.fillna(X.median(numeric_only=True))

    Xs = StandardScaler().fit_transform(X)
    pca = PCA(n_components=2)
    pcs = pca.fit_transform(Xs)

    fig, ax = plt.subplots(figsize=(8, 7))
    ax.scatter(pcs[:, 0], pcs[:, 1], s=45, alpha=0.8)

    for i, name in enumerate(patient_df["paciente"]):
        ax.annotate(str(name), (pcs[i, 0], pcs[i, 1]), fontsize=7)

    ax.set_xlabel(f"PC1 ({pca.explained_variance_ratio_[0]*100:.1f}%)")
    ax.set_ylabel(f"PC2 ({pca.explained_variance_ratio_[1]*100:.1f}%)")
    ax.set_title("PCA de las 9 características nucleares por paciente")

    fig.tight_layout()
    fig.savefig(OUT / "Figura_3_PCA_9_rasgos_por_paciente.png", dpi=300, bbox_inches="tight")
    plt.show()

# Comprimir y descargar
zip_result = shutil.make_archive(
    "/content/Resultados_9_caracteristicas_paper",
    "zip",
    OUT
)

print("\nLISTO")
print("Núcleos procesados:", len(pred_df))
print("Pacientes/carpetas:", pred_df["paciente"].nunique())
print("Archivo final:", zip_result)

files.download(zip_result)
